# SchoolSphere configuration. Copy to .env.local for development.
# Every value here is read on the SERVER only, except NEXT_PUBLIC_* values.
# Never commit real secrets.

# ---------------------------------------------------------------- app
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SchoolSphere
NEXT_PUBLIC_APP_TAGLINE=One School. One Platform. Complete Visibility.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# ---------------------------------------------------------------- database
# pglite   = in-process PostgreSQL stored in PGLITE_DATA_DIR (local development, no setup)
# postgres = any PostgreSQL 15+ such as Supabase (use the session pooler or direct connection string)
DB_DRIVER=pglite
PGLITE_DATA_DIR=.data/pglite
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# DATABASE_POOL_MAX=10

# ---------------------------------------------------------------- authentication
# local    = development/test only (refuses to run in production unless ALLOW_LOCAL_AUTH_IN_PRODUCTION=true)
# supabase = Supabase Auth (production)
AUTH_PROVIDER=local
# Required for local auth: 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
AUTH_SECRET=
ALLOW_LOCAL_AUTH_IN_PRODUCTION=false
# Supabase (required when AUTH_PROVIDER=supabase or STORAGE_DRIVER=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Development conveniences: one-click demo sign-in on /login, sandbox payments
# for demo schools. Must be false in production.
DEMO_MODE=true
# Password given to every seeded demo account (npm run db:seed). Development only.
DEMO_USER_PASSWORD=

# ---------------------------------------------------------------- file storage
# local = files under LOCAL_UPLOAD_DIR; supabase = private Supabase Storage bucket
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=.data/uploads
SUPABASE_STORAGE_BUCKET=school-files

# ---------------------------------------------------------------- payments
# none = counter payments only; razorpay = online payments for parents
PAYMENTS_PROVIDER=none
# Simulated checkout for DEMO schools only (is_demo = true). Never real money.
PAYMENTS_SANDBOX_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- AI assistant
# none | anthropic | openai. Without a key the assistant uses templates.
AI_PROVIDER=none
# Default for anthropic: claude-opus-5-5
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------- notifications
# In-app notifications always work. External channels send nothing unless this is true.
NOTIFICATIONS_EXTERNAL_ENABLED=false
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=
WHATSAPP_PROVIDER=none
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
PUSH_PROVIDER=none

# ---------------------------------------------------------------- transport
# Labelled location simulator for development. Set false in production.
TRANSPORT_SIMULATOR_ENABLED=true
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
